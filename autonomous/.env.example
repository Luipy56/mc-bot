# Secrets and connection only — copy to .env and fill in.
# Non-sensitive tuning lives in config/default.yml (optional overrides: config/local.yml).

# Bot display name (required)
NAME=

# Server address and port
SERVER_IP=
PORT=25565

# Minecraft client version (use "latest" in .env only if you rely on getConfig mapping; otherwise set a real version)
VERSION=latest

# Alternative names (used when NAME/SERVER_IP not set)
MC_HOST=
MC_USERNAME=
MC_PORT=
MC_VERSION=
MC_AUTH=offline

# Account password (online mode / some auth)
# MC_PASSWORD=

# AuthMe-style or similar: login command and password (do not commit real passwords)
# MC_LOGIN_CMD=
MC_AUTH_PASSWORD=
# MC_AUTH_PASSWORD_FILE=

# Friends list (comma-separated) for greetings and chunk-strip commands
# BOT_FRIENDS=

# Optional SSH host for !pr-style helpers
# PR_SSH_HOST=
